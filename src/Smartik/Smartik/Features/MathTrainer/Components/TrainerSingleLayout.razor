@using Smartik.Features.MathTrainer.Models
@using System.Timers
@implements IDisposable
@inject IJSRuntime JsRuntime

<div class="hide-on-print">
    <TrainerControl @bind-Count="Count"
                    @bind-MaxNumber="MaxNumber"
                    IsStarted="_isStarted"
                    IsChecked="_isChecked"
                    TimerText="@_timerText"
                    Presets="Presets"
                    OnStart="HandleStart"
                    OnCheck="CheckAnswers"
                    OnReset="ResetForm"
                    OnCancel="CancelTest" />
</div>

<TrainerResultAlert IsChecked="_isChecked" CorrectCount="_correctCount" TotalCount="Count" TimerText="@_timerText" />

@* 🌟 ИСПРАВЛЕНО: Выводим наглядную тетрадную сетку результатов через динамический шаблон ResultTemplate 🌟 *@
@if (_isChecked && Items.Count > 0)
{
    <RadzenCard Class="notebook-grid rz-p-6 rz-shadow-2 rz-my-4 hide-on-print" Style="max-width: 900px; margin: 2rem auto;">
        <RadzenText TextStyle="TextStyle.H5" Style="font-weight: 700; color: #1e293b;" Class="rz-mb-4 text-center">📊 Разбор твоих ответов:</RadzenText>

        <RadzenRow RowGap="1.5rem" ColumnGap="1rem">
            @for (int i = 0; i < Items.Count; i++)
            {
                var index = i;
                var item = Items[index];

                <RadzenColumn Size="12" SizeMd="6" SizeXl="4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="flex-wrap: nowrap; padding: 0.5rem; border-radius: 8px; border: 1px dashed #cbd5e1; background-color: #f8fafc;">

                        <!-- Выводим кастомный шаблон примера со страницы, передавая индекс -->
                        @ResultTemplate(index)

                    </RadzenStack>
                </RadzenColumn>
            }
        </RadzenRow>
    </RadzenCard>
}

@if (_isStarted && Items.Count > 0 && !_isChecked)
{
    <RadzenStack Gap="0.5rem" Class="rz-mb-4 hide-on-print" Style="width: 100%;">
        <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0" Style="font-weight: bold; color: var(--rz-text-secondary-color);">
            🚀 Пример @(_currentIndex + 1) из @Count
        </RadzenText>
        <RadzenProgressBar Value="@_progressValue" Max="100" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Success" Style="height: 10px; border-radius: 5px;" />
    </RadzenStack>

    <RadzenCard Class="notebook-grid rz-p-8 rz-shadow-3 rz-text-align-center single-trainer-card" Style="max-width: 600px; margin: 2rem auto; border: 3px solid var(--rz-primary-light) !important; border-radius: 16px !important; width: 100%;">
        <RadzenStack AlignItems="AlignItems.Center" Gap="2rem">

            @ChildContent(_currentIndex)

            <RadzenButton Click="HandleNextClick"
                          Text="@(_currentIndex + 1 == Count ? "Завершить 🎉" : "Далее 👉")"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Large"
                          Class="hide-on-print"
                          Style="min-width: 180px; font-size: 1.2rem; font-weight: bold; border-radius: 12px;" />
        </RadzenStack>
    </RadzenCard>
}
else if (!_isStarted && !_isChecked)
{
    @PlaceholderContent
}

@code {
    [Parameter] public int Count { get; set; } = 12;
    [Parameter] public EventCallback<int> CountChanged { get; set; }
    [Parameter] public int MaxNumber { get; set; } = 10;
    [Parameter] public EventCallback<int> MaxNumberChanged { get; set; }

    [Parameter] public List<TrainerControl.TrainerPreset> Presets { get; set; } = [];
    [Parameter] public List<ITrainerItem> Items { get; set; } = [];

    [Parameter] public RenderFragment<int> ChildContent { get; set; } = default!;
    [Parameter] public RenderFragment? PlaceholderContent { get; set; }

    // 🌟 НОВЫЙ ПАРАМЕТР: Шаблон для отрисовки примера в таблице результатов 🌟
    [Parameter] public RenderFragment<int> ResultTemplate { get; set; } = default!;

    [Parameter] public Func<Task>? OnGenerateRequired { get; set; }
    [Parameter] public Func<int, Task>? OnFocusRequired { get; set; }
    [Parameter] public Func<int, Task>? OnNextStepRequired { get; set; }

    public bool IsChecked => _isChecked;

    protected bool _isStarted = false;
    protected bool _isChecked = false;
    protected int _currentIndex = 0;
    protected int _correctCount = 0;
    protected string _timerText = "00:00";
    protected double _progressValue = 0;

    private Timer? _timer;
    private int _secondsElapsed = 0;
    private bool _shouldLaunchConfetti = false;
    private bool _shouldFocusInput = false;

    protected override void OnInitialized()
    {
        _timer = new Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocusInput && OnFocusRequired != null && _isStarted && !_isChecked)
        {
            _shouldFocusInput = false;
            await OnFocusRequired.Invoke(_currentIndex);
        }

        if (_shouldLaunchConfetti)
        {
            _shouldLaunchConfetti = false;
            await JsRuntime.InvokeVoidAsync("window.mathTrainer.launchConfetti");
        }
    }

    private async Task HandleStart()
    {
        await CountChanged.InvokeAsync(Count);
        await MaxNumberChanged.InvokeAsync(MaxNumber);

        if (OnGenerateRequired != null) await OnGenerateRequired.Invoke();

        _currentIndex = 0; _progressValue = 0; _isChecked = false; _correctCount = 0; _secondsElapsed = 0; _timerText = "00:00"; _shouldLaunchConfetti = false;
        _isStarted = true;

        StateHasChanged();
        _shouldFocusInput = true;
        _timer?.Start();
    }

    public async Task HandleNextClick()
    {
        if (OnNextStepRequired != null)
        {
            await OnNextStepRequired.Invoke(_currentIndex);
        }

        if (_currentIndex + 1 < Items.Count)
        {
            _currentIndex++;
            _progressValue = ((double)_currentIndex / Count) * 100;
            StateHasChanged();
            _shouldFocusInput = true;
        }
        else
        {
            await CheckAnswers();
        }
    }

    private void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        _secondsElapsed++;
        _timerText = TimeSpan.FromSeconds(_secondsElapsed).ToString(@"mm\:ss");
        InvokeAsync(StateHasChanged);
    }

    public async Task CheckAnswers()
    {
        if (_isChecked) return;
        await Task.Delay(60);
        _timer?.Stop();

        _correctCount = Items.Count(e => e.IsCorrect);
        _isChecked = true; _shouldLaunchConfetti = true;
        await InvokeAsync(StateHasChanged);
    }

    private void ResetForm() { _isStarted = false; _isChecked = false; _correctCount = 0; _timerText = "00:00"; _currentIndex = 0; Items.Clear(); }
    private void CancelTest() { _timer?.Stop(); ResetForm(); }

    public void Dispose() { _timer?.Dispose(); GC.SuppressFinalize(this); }
}
