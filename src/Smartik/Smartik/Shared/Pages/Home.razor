@page "/"
@inject NavigationManager NavigationManager

<PageTitle>Smartik — Академия Дошкольника</PageTitle>

<RadzenStack AlignItems="AlignItems.Center" Gap="2rem" Class="rz-w-100">

    <RadzenCard Variant="Variant.Filled"
                Style="background: linear-gradient(135deg, var(--rz-primary-lighter), var(--rz-info-lighter)); border-radius: 16px; width: 100%; max-width: 900px;"
                Class="rz-p-6 rz-p-sm-8 rz-shadow-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" JustifyContent="JustifyContent.Center" Class="rz-w-100">
            <span style="font-size: 5rem;">🚀</span>
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" Style="color: var(--rz-primary-dark); font-weight: 800;" Class="rz-m-0">
                    Привет, я Смартик!
                </RadzenText>
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.P" Style="color: #334155; font-weight: 500;" Class="rz-m-0">
                    Welcome в академию умных дошкольников. Давай тренироваться вместе!
                </RadzenText>
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H5" Style="font-weight: 700; color: #1e293b;" Class="rz-m-0 rz-mt-4">🎈 Выбери занятие на сегодня:</RadzenText>

    <RadzenRow Style="width: 100%; max-width: 900px;" RowGap="1.5rem" ColumnGap="1rem">

        <!-- КАРТОЧКА 1: Тренажер «Умный счет» -->
        <RadzenColumn Size="12" SizeMd="6">
            <RadzenCard Variant="Variant.Outlined"
                        Style="cursor: pointer; border: 2px solid var(--rz-primary-light); border-radius: 12px; transition: all 0.2s ease-in-out; height: 100%;"
                        Class="rz-p-5 home-card-interactive"
                        @onclick='() => NavigationManager.NavigateTo("/trainer/mixed")'>
                <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%; min-height: 220px;">
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                            <span style="font-size: 2.5rem;">🔢</span>
                            <RadzenText TextStyle="TextStyle.H5" Style="font-weight: 700; color: var(--rz-primary-dark);" Class="rz-m-0">Умный счет</RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body1" Style="color: #475569;" Class="rz-m-0">
                            Тренажер примеров на сложение и вычитание в тетрадную клеточку. Можно настроить количество заданий, решать на скорость или распечатать бланк!
                        </RadzenText>
                    </RadzenStack>
                    <RadzenButton Text="Запустить" Icon="play_arrow" ButtonStyle="ButtonStyle.Primary" Class="rz-w-100 rz-mt-4" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <!-- КАРТОЧКА 2: ИСПРАВЛЕНО И ЗАПУЩЕНО! Тренажер «Логика и неравенства» -->
        <RadzenColumn Size="12" SizeMd="6">
            <RadzenCard Variant="Variant.Outlined"
                        Style="cursor: pointer; border: 2px solid var(--rz-info-light); border-radius: 12px; transition: all 0.2s ease-in-out; height: 100%;"
                        Class="rz-p-5 home-card-interactive"
                        @onclick='() => NavigationManager.NavigateTo("/trainer/logic")'>
                <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%; min-height: 220px;">
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                            <span style="font-size: 2.5rem;">🧠</span>
                            <RadzenText TextStyle="TextStyle.H5" Style="font-weight: 700; color: var(--rz-info-dark);" Class="rz-m-0">Логика и неравенства</RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body1" Style="color: #475569;" Class="rz-m-0">
                            Увлекательные задачки подставить нужное число или подобрать правильный знак сравнения (больше, меньше, равно) для будущих отличников.
                        </RadzenText>
                    </RadzenStack>
                    <RadzenButton Text="Запустить" Icon="play_arrow" ButtonStyle="ButtonStyle.Info" Class="rz-w-100 rz-mt-4" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
        <!-- КАРТОЧКА 3: Фокус-Счет -->
        <RadzenColumn Size="12" SizeMd="6" Class="rz-mt-4">
            <RadzenCard Variant="Variant.Outlined" Style="cursor: pointer; border: 2px solid var(--rz-success-light); border-radius: 12px; transition: all 0.2s ease-in-out; height: 100%;" Class="rz-p-5 home-card-interactive" @onclick='() => NavigationManager.NavigateTo("/trainer/mixed-single")'>
                <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%; min-height: 220px;">
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                            <span style="font-size: 2.5rem;">🎯</span>
                            <RadzenText TextStyle="TextStyle.H5" Style="font-weight: 700; color: var(--rz-success-dark);" Class="rz-m-0">Фокус-счет</RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body1" Style="color: #475569;" Class="rz-m-0">Тренажер счета по одной большой карточке на экране. Идеально для концентрации внимания дошкольников.</RadzenText>
                    </RadzenStack>
                    <RadzenButton Text="Запустить" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" Class="rz-w-100 rz-mt-4" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <!-- КАРТОЧКА 4: Фокус-Логика -->
        <RadzenColumn Size="12" SizeMd="6" Class="rz-mt-4">
            <RadzenCard Variant="Variant.Outlined" Style="cursor: pointer; border: 2px solid var(--rz-warning-light); border-radius: 12px; transition: all 0.2s ease-in-out; height: 100%;" Class="rz-p-5 home-card-interactive" @onclick='() => NavigationManager.NavigateTo("/trainer/logic-single")'>
                <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%; min-height: 220px;">
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                            <span style="font-size: 2.5rem;">💡</span>
                            <RadzenText TextStyle="TextStyle.H5" Style="font-weight: 700; color: var(--rz-warning-dark);" Class="rz-m-0">Фокус-логика</RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body1" Style="color: #475569;" Class="rz-m-0">Логические неравенства крупным шрифтом по одному заданию на экране. Ничего не отвлекает ребенка от победы!</RadzenText>
                    </RadzenStack>
                    <RadzenButton Text="Запустить" Icon="play_arrow" ButtonStyle="ButtonStyle.Warning" Class="rz-w-100 rz-mt-4" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>
